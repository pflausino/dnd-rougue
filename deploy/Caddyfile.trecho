# Bloco a acrescentar ao Caddyfile do proxy do VPS (`/opt/proxy/Caddyfile`),
# que já serve os outros sites. **Não é um Caddyfile completo** — colar isto
# sobre o arquivo inteiro derruba tudo o que já está lá.
#
#   cp /opt/proxy/Caddyfile /opt/proxy/Caddyfile.bak
#   cat deploy/Caddyfile.trecho >> /opt/proxy/Caddyfile
#   docker exec caddy caddy validate --config /etc/caddy/Caddyfile
#   docker exec caddy caddy reload --config /etc/caddy/Caddyfile
#
# Validar antes de recarregar não é zelo: um erro de sintaxe aqui derruba os
# outros sites do mesmo proxy.

dungeon.pflausino.xyz {
	# O SSE fica em rota própria, sem compressão e sem buffer. Comprimido ou
	# bufferizado, o fluxo de eventos só chega quando enche um bloco — as telas
	# param de sincronizar e o aviso de conexão pisca sem motivo.
	@eventos path /api/eventos
	handle @eventos {
		reverse_proxy dungeon:8777 {
			flush_interval -1
		}
	}

	# Os MP3 da trilha também saem sem `encode`, e por um motivo que só aparece
	# em produção. Com `Accept-Encoding: gzip` no pedido — que todo navegador
	# manda, e o `curl` só manda se pedirem — o Caddy devolve `200` sem
	# `Content-Range` no lugar do `206` que o servidor produziu. O `<audio>`
	# pede a faixa, não recebe cabeçalho de faixa nenhum e trava em `stalled`,
	# calado: a trilha simplesmente não toca, sem erro no console. No servidor
	# local não há proxy, então lá sempre funcionou.
	#
	# MP3 já é formato comprimido; tirá-lo do `encode` não custa banda nenhuma.
	@trilha path /webapp/assets/audio/*
	handle @trilha {
		reverse_proxy dungeon:8777
	}

	handle {
		encode zstd gzip
		reverse_proxy dungeon:8777
	}
}
